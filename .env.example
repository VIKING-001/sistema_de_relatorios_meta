# Banco de Dados PostgreSQL
# Exemplo: postgresql://usuario:senha@localhost:5432/nome_banco
DATABASE_URL="postgresql://user:password@localhost:5432/database"

# Vercel OIDC Token (se usar Vercel)
VERCEL_OIDC_TOKEN=""

