# Banco de Dados PostgreSQL
# Exemplo: postgresql://usuario:senha@localhost:5432/nome_banco
DATABASE_URL="postgresql://user:password@localhost:5432/database"

# Vercel OIDC Token (se usar Vercel)
VERCEL_OIDC_TOKEN=""

# Meta Ads API (opcional, será configurado via UI)
# META_ACCESS_TOKEN=""
# META_AD_ACCOUNT_ID=""

# Meta App (OAuth de anúncios + Embedded Signup do WhatsApp)
META_APP_ID=""
META_APP_SECRET=""

# WhatsApp Cloud API — conexão "1 clique" (Embedded Signup)
# config_id criado no painel da Meta (App -> WhatsApp -> Embedded Signup)
WHATSAPP_CONFIG_ID=""
# token de verificação do webhook (o mesmo cadastrado no painel da Meta)
WHATSAPP_VERIFY_TOKEN=""

# Variáveis expostas ao frontend (Vite) — necessárias para o botão 1 clique
VITE_META_APP_ID=""
VITE_WHATSAPP_CONFIG_ID=""

# Web Push (PWA) — gere com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_CONTACT_EMAIL="raioshops@gmail.com"
# Exposta ao frontend para criar a PushSubscription
VITE_VAPID_PUBLIC_KEY=""

# Cron — o Vercel injeta automaticamente quando configurado em vercel.json
# Defina um valor forte e aleatório aqui e no painel do Vercel
CRON_SECRET=""
